{
  "name": "reviewgate",
  "main": "src/worker.ts",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reviewgate-production",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ]
}
